    "description": "Accessible radar and spider charts with per-axis scaling, wide and long table support, and raw-value inspection.",
    "author": { "name": "Aviad Shiber", "url": "https://github.com/aviadshiber" },
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "links": [
      { "name": "GitHub", "url": "https://github.com/aviadshiber/grafana-spider-graph" },
      { "name": "Documentation", "url": "https://github.com/aviadshiber/grafana-spider-graph#readme" },
      { "name": "Report an issue", "url": "https://github.com/aviadshiber/grafana-spider-graph/issues" }
    ],
    "screenshots": [
      {
        "name": "SpiderGraph service comparison dashboard",
        "path": "img/spidergraph-overview.png"
      }
